# Crypto Signal Engine

# --- Server ---
PORT=3000

# --- Scanner ---
QUOTE=USDT
UNIVERSE_SIZE=60          # how many top markets to scan
SIGNAL_TF=1h             # default timeframe: 15m | 1h | 4h | 1d
SIGNAL_MIN_CONFIDENCE=45 # min % to emit LONG/SHORT (lower = more signals)
SCAN_INTERVAL_SEC=5       # live PRICE + target/stop check cadence, seconds (1 request/tick)
INDICATOR_REFRESH_SEC=60  # heavy indicator rescan cadence, seconds (whole market)
FALLBACK_USD_LKR=300
# Exchange priority for market data (first reachable is used). ccxt-style layer.
EXCHANGES=binance   # you trade on Binance -> Binance-only; add ,bybit,okx as fallback if needed

# --- Signal outcome tracking ---
# Only log signals at/above this confidence for the win-rate track record.
TRACK_MIN_CONFIDENCE=95   # only track very-high-conviction (>=95%) setups
MAX_WAIT_CANDLES=12      # cancel a signal if entry not filled within N candles
MAX_HOLD_CANDLES=60      # close a trade after N candles in the market
# Optional Postgres (Railway plugin) makes the track record DURABLE across
# restarts. Without it, tracking is in-memory (resets on redeploy).
DATABASE_URL=""

# --- Binance SPOT TESTNET trading (paper money; optional) ---
# Get keys at https://testnet.binance.vision (Generate HMAC_SHA256 key). TESTNET ONLY.
# You can also set these from the app's Settings tab instead of here.
BINANCE_TESTNET_KEY=""
BINANCE_TESTNET_SECRET=""
AUTO_TRADE=false          # true = auto-buy $TRADE_USD of every >=95% LONG signal
TRADE_USD=100             # spend per trade (spot BUY); closes at TP1 or the stop
QUALITY_ONLY=true         # only auto-trade Blue-chip/Solid coins (high liquidity, low volatility)
HOLD_THROUGH_DIPS=false   # true = no stop: hold a sideways spot until TP1 (quality coins recover)
REGIME_FILTER=true        # pause auto-buys when the market is risk-off (BTC weak / low breadth)
EXIT_STYLE=tp1            # tp1 = bank full +1R at first target (best win rate) | scaleout = ride to TP3
MIN_TRACK_LIQUIDITY_USD=15000000   # ignore illiquid junk (tokenized stocks, micro-caps) below this 24h volume
# BINANCE_TESTNET_BASE=https://testnet.binance.vision   # override if needed
# If Binance geo-blocks your server ("restricted location"), route via a proxy
# in an allowed region (also settable from the Settings tab):
# BINANCE_PROXY_URL=http://user:pass@host:port

# --- Forex Bot (OANDA v20; optional) ---
# Create a free PRACTICE (demo) account at oanda.com, then Manage API Access ->
# Generate a token. Account ID looks like 101-001-1234567-001. You can also set
# these from the Forex Bot tab instead of here. Start on practice.
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""
OANDA_ACCOUNT_TYPE=practice   # practice | live  (default practice)
FOREX_PAIR=EUR_USD
FOREX_GRANULARITY=M15         # M5 | M15 | M30 | H1 | H4 | D
FOREX_STRATEGY=ema_rsi        # pluggable; ema_rsi = EMA crossover + RSI filter
FOREX_RISK_USD=10             # ~$ risked per trade (sizes the position from the stop distance)
FOREX_MAX_UNITS=100000        # hard cap on position size (units of base currency)
FOREX_DAILY_MAX_LOSS=50       # halt the bot for the day if realized PnL drops below -this

# --- Built-in PAPER trading (simulated SPOT broker; no exchange/keys/proxy) ---
PAPER_TRADING=true        # auto-buy good >=95% coins at live prices, sell at TP1/stop, rotate
PAPER_MAX_OPEN=5          # max coins held at once (portfolio slots)
PAPER_POSITION_USD=20     # $ spent per spot trade (buys this much of the coin)
PAPER_GOAL_USD=10         # profit target for the session (progress bar)
PAPER_MAX_ETA_MIN=0       # 0 = any; else only take setups whose TP1 ETA <= this many minutes
# Setups are ranked by ROI-per-hour x accuracy; freed cash rotates into the next best coin.
# CAPITAL_USD is the starting cash pot.

# --- Telegram alerts + ask-before-you-trade (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TG_APPROVAL=false        # true = message you before each >=95% trade with Take/Skip buttons
POSITION_USD=20          # $ you'd put per trade (drives the "TP1 = +$Y" projection)
CAPITAL_USD=200          # your total capital (context)
