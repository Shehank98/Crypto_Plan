# --- Required ---
# Railway Postgres connection string (Variables: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:pass@host:port/db"

# --- Optional: AI analyst (the ONLY paid key). Without it a rule-based analyst is used. ---
GEMINI_API_KEY=""

# --- Optional: Telegram bot (polling). Leave blank to disable. ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""      # chat/channel id to receive 6-hour dip alerts

# --- Tuning (all optional) ---
PORT=3000
MONTHLY_BUDGET_LKR=10000
DCA_DAY_OF_MONTH=1
FALLBACK_USD_LKR=300
