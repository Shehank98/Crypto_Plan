# --- Required ---
# Railway Postgres connection string (Variables: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:pass@host:port/db"

# --- Optional: AI analyst (the ONLY paid key). Without it a rule-based analyst is used. ---
GEMINI_API_KEY=""

# --- Optional: Telegram bot (polling). Leave blank to disable. ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""      # chat/channel id to receive 6-hour dip alerts

# --- Tuning (all optional) ---
PORT=3000
MONTHLY_BUDGET_LKR=10000
DCA_DAY_OF_MONTH=1
FALLBACK_USD_LKR=300
# Automatically log the Mayer-scaled monthly buys on DCA_DAY_OF_MONTH. Set to
# "false" to disable and only log manually / via /dca / POST /api/auto-dca.
AUTO_DCA=true

# Coins to track — comma-separated symbols. Add as many as you like; Binance
# uses <SYMBOL>USDT pairs. Default: BTC,ETH,SOL,BNB
COINS=BTC,ETH,SOL,BNB
# Optional: extend/override the symbol -> CoinGecko id map (JSON) for the
# keyless fallback on coins not in the built-in list.
# COIN_IDS={"FOO":"foo-token"}

# History window analysed (years) and forward projection horizon (years).
HISTORY_YEARS=5
PROJECTION_YEARS=3

# --- Scalping signals ---
# Default timeframe for signals: 5m | 15m | 1h | 4h
SIGNAL_TF=15m
# Minimum confluence confidence (0-100) to emit a LONG/SHORT instead of NEUTRAL.
# Lower = more (noisier) signals; higher = fewer, higher-conviction setups.
SIGNAL_MIN_CONFIDENCE=45
