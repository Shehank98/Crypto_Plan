# Crypto Signal Engine — signals only, NO database required.

# --- Server ---
PORT=3000

# --- Scanner ---
# Quote currency for pairs (Binance <BASE>USDT).
QUOTE=USDT
# How many of the most-liquid markets to scan.
UNIVERSE_SIZE=50
# Default timeframe: 5m | 15m | 1h | 4h  (day trading -> 1h)
SIGNAL_TF=1h
# Min confluence confidence (0-100) to emit LONG/SHORT instead of NEUTRAL.
# Lower = more signals; higher = fewer, higher-conviction.
SIGNAL_MIN_CONFIDENCE=45
# Background rescan interval (minutes).
SCAN_INTERVAL_MIN=5
# USD->LKR fallback if the FX API is unreachable (display only).
FALLBACK_USD_LKR=300

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""   # optional; any chat that messages the bot is auto-added
