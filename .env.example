# Crypto Signal Engine

# --- Server ---
PORT=3000

# --- Scanner ---
QUOTE=USDT
UNIVERSE_SIZE=60          # how many top markets to scan
SIGNAL_TF=1h             # default timeframe: 5m | 15m | 1h | 4h
SIGNAL_MIN_CONFIDENCE=45 # min % to emit LONG/SHORT (lower = more signals)
SCAN_INTERVAL_MIN=5      # background rescan cadence
FALLBACK_USD_LKR=300
# Exchange priority for market data (first reachable is used). ccxt-style layer.
EXCHANGES=binance,bybit,okx

# --- Signal outcome tracking ---
# Only log signals at/above this confidence for the win-rate track record.
TRACK_MIN_CONFIDENCE=55
MAX_WAIT_CANDLES=12      # cancel a signal if entry not filled within N candles
MAX_HOLD_CANDLES=60      # close a trade after N candles in the market
# Optional Postgres (Railway plugin) makes the track record DURABLE across
# restarts. Without it, tracking is in-memory (resets on redeploy).
DATABASE_URL=""

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
