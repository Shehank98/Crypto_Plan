# Optional. The UI calls the API same-origin at /api and next.config.mjs proxies
# it to the Express server, so you normally do NOT need to set this.
# Set it only if you run the API on a separate origin (bypasses the proxy).
# NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional. Where next.config.mjs proxies /api to (server-side). Default below.
# API_INTERNAL_URL="http://127.0.0.1:4000"
