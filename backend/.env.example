# Railway Postgres connection string
DATABASE_URL="postgresql://user:password@host:port/dbname"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# API server
PORT=4000

# --- Ingestion ---
# Optional CoinGecko API key. Leave blank to use the free public tier
# (heavily rate limited). A demo/pro key raises limits and enables the
# x-cg-* auth header.
COINGECKO_API_KEY=""
# Base URL. Use https://pro-api.coingecko.com/api/v3 if you have a pro key.
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"

# Free forex history API (frankfurter.dev needs no key). USD->LKR is not
# always covered by every free provider; frankfurter does not include LKR,
# so we default to exchangerate.host which does. Override if needed.
FX_BASE_URL="https://api.exchangerate.host"
# Optional access key for exchangerate.host (their newer plans require one).
FX_ACCESS_KEY=""

# How far back to backfill (ISO date). CoinGecko free tier caps history to
# ~365 days for market_chart/range unless you have a paid plan.
BACKFILL_FROM="2019-01-01"
