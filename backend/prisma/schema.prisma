// Prisma schema for the crypto DCA planner.
// Connects to Railway Postgres via the DATABASE_URL env var.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plans     Plan[]
  purchases Purchase[]

  @@map("users")
}

model Coin {
  id          Int      @id @default(autoincrement())
  symbol      String   @unique // e.g. "BTC"
  name        String // e.g. "Bitcoin"
  coingeckoId String   @unique @map("coingecko_id") // e.g. "bitcoin"
  createdAt   DateTime @default(now()) @map("created_at")

  priceHistory PriceHistory[]
  purchases    Purchase[]

  @@map("coins")
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  coinId     Int      @map("coin_id")
  date       DateTime @db.Date // day-granularity, UTC midnight
  priceUsd   Decimal  @map("price_usd") @db.Decimal(24, 8)
  volume     Decimal? @db.Decimal(30, 4)
  marketCap  Decimal? @map("market_cap") @db.Decimal(30, 4)
  createdAt  DateTime @default(now()) @map("created_at")

  coin Coin @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@unique([coinId, date])
  @@index([coinId, date])
  @@map("price_history")
}

model FxRate {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  usdToLkr  Decimal  @map("usd_to_lkr") @db.Decimal(18, 6)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("fx_rates")
}

model Plan {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  name               String
  monthlyAmountLkr   Decimal  @map("monthly_amount_lkr") @db.Decimal(18, 2)
  // Day of month purchases land on (1-28).
  purchaseDayOfMonth Int      @default(1) @map("purchase_day_of_month")
  // Date the plan's contributions begin.
  startDate          DateTime @map("start_date") @db.Date
  // Array of { coinId: number, pct: number }. pct values should sum to 100.
  allocations        Json     @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results PlanResult[]

  @@index([userId])
  @@map("plans")
}

model PlanResult {
  id                Int      @id @default(autoincrement())
  planId            Int      @map("plan_id")
  // Cached engine output. Shapes defined in src/engine/types.ts.
  backtestResults   Json     @map("backtest_results") @db.JsonB
  montecarloResults Json     @map("montecarlo_results") @db.JsonB
  // Snapshot of the plan + data range the results were computed against,
  // so a cached result can be invalidated when inputs change.
  inputsHash        String   @map("inputs_hash")
  computedAt        DateTime @default(now()) @map("computed_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_results")
}

// A single manual purchase logged by a user. The price at the purchase date is
// captured at creation from price_history + fx_rates, and `units` derived from it.
model Purchase {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  coinId    Int      @map("coin_id")
  date      DateTime @db.Date // the purchase date
  amountLkr Decimal  @map("amount_lkr") @db.Decimal(18, 2)
  // Captured price context at (or on/before) the purchase date.
  priceUsd  Decimal  @map("price_usd") @db.Decimal(24, 8)
  usdToLkr  Decimal  @map("usd_to_lkr") @db.Decimal(18, 6)
  units     Decimal  @db.Decimal(36, 18) // amountLkr / (priceUsd * usdToLkr)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin Coin @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, coinId])
  @@map("purchases")
}
