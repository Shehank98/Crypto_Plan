{
  "name": "crypto-signal-engine",
  "version": "2.0.0",
  "private": true,
  "description": "Signals-only crypto scalping engine — scans the top markets and emits trend-following trade signals (entry, stop, TP, ETA, forecast). No database.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "build:css": "npx --yes tailwindcss@3.4.17 -c ./tailwind.config.js -i ./tailwind-input.css -o ./public/tailwind.css --minify"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.23.0"
  }
}
